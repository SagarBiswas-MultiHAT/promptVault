{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // Playwright's `page.evaluate` callbacks run in the browser, so specs need
    // both the DOM lib and Node types.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "allowImportingTsExtensions": true,
    // Hook tests render real components to assert subscribe/unsubscribe behaviour.
    "jsx": "react-jsx"
  },
  "include": ["tests"]
}
