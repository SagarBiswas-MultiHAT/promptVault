{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"],
    // The server runs through tsx, which resolves real .ts specifiers on disk.
    "allowImportingTsExtensions": true
  },
  "include": ["server"]
}
