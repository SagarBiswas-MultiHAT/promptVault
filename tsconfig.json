{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "types": ["vite/client"],
    // Matches the Vite alias in vite.config.ts (`@` -> ./src). Previously these
    // disagreed: tsconfig mapped `@/*` to `./*` while Vite mapped it to `./src`.
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
