{
  "name": "promptvault",
  "version": "2.3.0",
  "private": true,
  "description": "The Private, Offline-First Prompt Manager for AI Agent Power Users",
  "author": "Sagar Biswas <https://multihat.dev> (https://github.com/SagarBiswas-MultiHAT)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/SagarBiswas-MultiHAT/promptVault.git"
  },
  "homepage": "https://github.com/SagarBiswas-MultiHAT/promptVault#readme",
  "bugs": {
    "url": "https://github.com/SagarBiswas-MultiHAT/promptVault/issues"
  },
  "keywords": [
    "prompt-manager",
    "prompt-engineering",
    "offline-first",
    "aes-256-gcm",
    "ai-librarian",
    "gemini",
    "groq",
    "supabase-sync",
    "react-19",
    "pwa"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:api": "tsx server/index.ts",
    "build": "vite build",
    "start": "cross-env NODE_ENV=production node --import tsx server/index.ts",
    "preview": "vite preview",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build:ext": "tsx scripts/build-extension.ts",
    "clean:ext": "node -e \"require('fs').rmSync('dist-extension',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.server.json && tsc -p tsconfig.node.json && tsc -p tsconfig.test.json && tsc -p tsconfig.ext.json",
    "lint": "npm run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:keys": "tsx scripts/test-api-keys.ts",
    "test:keys:wait": "tsx scripts/test-api-keys.ts --wait",
    "generate:og": "tsx scripts/generate-og-image.ts",
    "optimize:assets": "tsx scripts/optimize-assets.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "compression": "^1.8.2",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.3",
    "express": "^4.22.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/chrome": "^0.3.6",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.4.5",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "esbuild": ">=0.28.1"
  }
}
