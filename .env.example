# Environment configuration for PromptVault
# Copy this file to .env and fill in your values.
#
# Precedence: real process environment > this .env file > the built-in defaults
# in server/config.ts. A stale .env committed into a deploy image therefore
# cannot override the platform's own variables.

# --- AI Provider Keys ---
# API keys are used only by the Express proxy server and never exposed to the client.
# At least one provider must be configured for the AI Librarian to function.
# Gemini is tried first; Groq is the fallback.

GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
GEMINI_MODEL="gemini-3.6-flash"

GROQ_API_KEY="YOUR_GROQ_API_KEY"
GROQ_MODEL="llama-3.3-70b-versatile"

# --- AI Provider Tuning (optional) ---
# Upstream request deadline per provider, in milliseconds. Without a deadline a
# hung connection to Gemini means the Groq fallback never fires and the request
# hangs until the client gives up.
# GEMINI_TIMEOUT_MS="20000"
# GROQ_TIMEOUT_MS="20000"

# Maximum output tokens per generation. Reasoning-capable models bill thinking
# tokens against this budget, so a tight value can truncate a JSON response
# mid-object. Truncation is detected and treated as a provider failure.
# MAX_OUTPUT_TOKENS="8192"

# --- Server ---
# Port for the API proxy server (also serves the frontend in production).
AI_PROXY_PORT="3002"

# Number of trusted reverse proxies in front of this server. Defaults to 1 in
# production and 0 in development.
#
# Behind Render / Railway / Fly / Cloudflare, leaving this at 0 makes req.ip the
# *proxy's* address, so every user shares a single rate-limit bucket — an
# effective 30 req/min cap for the whole deployment. Keep the count exact:
# over-trusting lets a client spoof X-Forwarded-For and escape its own bucket.
# TRUST_PROXY_HOPS="1"

# --- Supabase Auth + Sync ---
# Optional. Leave both unset and cloud sync is disabled; the vault stays local.
#
# IMPORTANT — VITE_* variables are BUILD-time, not run-time. Vite substitutes them
# into the JavaScript bundle during `npm run build`, so setting them in a host's
# environment panel does nothing unless that host also rebuilds afterwards. If you
# change either value you must rebuild and redeploy. (This is also why they are
# not secrets in the usual sense: the anon key ships inside the bundle and is
# readable by anyone. Access control is Supabase's row-level security, not the
# key's secrecy — see the RLS policies in the README.)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# --- Production ---
# Set to "production" when deploying. Enables static file serving, HSTS, and stricter validation.
# NODE_ENV="production"

# Comma-separated list of allowed CORS origins. REQUIRED in production: the
# server refuses to start without it rather than falling back to
# "Access-Control-Allow-Origin: *", since an empty allowlist should mean "allow
# nothing", not "allow everything".
# ALLOWED_ORIGINS="https://promptvault.app,https://www.promptvault.app"
